# Copiar este ficheiro para ".env" e preencher com os vossos dados.
# O ficheiro .env NUNCA deve ir para o GitHub (está no .gitignore).
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=achados_perdidos
# Frase secreta longa e aleatória, usada para assinar os tokens de sessão
JWT_SECRET=muda-isto-para-uma-frase-longa-e-aleatoria
